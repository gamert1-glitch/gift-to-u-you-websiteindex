<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>MarketHub - Online Store</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      color: #333;
    }

    header {
      background: #ff9800;
      padding: 15px;
      color: white;
    }

    .top {
      max-width: 1100px;
      margin: auto;
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    .search {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 5px;
      font-size: 15px;
    }

    .cart {
      font-weight: bold;
    }

    nav {
      background: white;
      padding: 12px;
      text-align: center;
    }

    nav a {
      margin: 0 15px;
      text-decoration: none;
      color: #333;
    }

    .hero {
      max-width: 1100px;
      margin: 20px auto;
      padding: 45px 25px;
      background: #222;
      color: white;
      border-radius: 8px;
    }

    .hero h1 {
      margin-bottom: 10px;
    }

    .products {
      max-width: 1100px;
      margin: 20px auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 20px;
      padding: 10px;
    }

    .product {
      background: white;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }

    .product-image {
      height: 150px;
      background: #ddd;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 5px;
      font-size: 50px;
    }

    .product h3 {
      margin: 12px 0 5px;
    }

    .price {
      font-size: 18px;
      font-weight: bold;
      margin: 8px 0;
    }

    button {
      width: 100%;
      padding: 11px;
      border: none;
      border-radius: 5px;
      background: #ff9800;
      color: white;
      cursor: pointer;
      font-weight: bold;
    }

    #message {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #222;
      color: white;
      padding: 15px;
      border-radius: 7px;
      display: none;
    }
  </style>
</head>

<body>

<header>
  <div class="top">
    <div class="logo">MarketHub</div>

    <input
      class="search"
      type="search"
      placeholder="Search for products..."
    >

    <div class="cart">🛒 Cart</div>
  </div>
</header>

<nav>
  <a href="#">Phones</a>
  <a href="#">Electronics</a>
  <a href="#">Fashion</a>
  <a href="#">Home</a>
  <a href="#">Beauty</a>
</nav>

<section class="hero">
  <h1>Shop Online</h1>
  <p>Discover products from sellers across Nigeria.</p>
</section>

<section class="products">

  <div class="product">
    <div class="product-image">📱</div>
    <h3>Smartphone</h3>
    <p>Modern Android smartphone</p>
    <div class="price">₦85,000</div>
    <button onclick="addToCart('Smartphone')">
      Add to Cart
    </button>
  </div>

  <div class="product">
    <div class="product-image">🎧</div>
    <h3>Wireless Headphones</h3>
    <p>Bluetooth headphones</p>
    <div class="price">₦18,500</div>
    <button onclick="addToCart('Wireless Headphones')">
      Add to Cart
    </button>
  </div>

  <div class="product">
    <div class="product-image">👟</div>
    <h3>Sneakers</h3>
    <p>Casual everyday sneakers</p>
    <div class="price">₦25,000</div>
    <button onclick="addToCart('Sneakers')">
      Add to Cart
    </button>
  </div>

  <div class="product">
    <div class="product-image">⌚</div>
    <h3>Smart Watch</h3>
    <p>Fitness and notification features</p>
    <div class="price">₦32,000</div>
    <button onclick="addToCart('Smart Watch')">
      Add to Cart
    </button>
  </div>

</section>

<div id="message"></div>

<script>
  function addToCart(product) {
    const message = document.getElementById("message");

    message.textContent =
      product + " added to your demo cart.";

    message.style.display = "block";

    setTimeout(function() {
      message.style.display = "none";
    }, 2000);
  }
</script>

</body>
</html>